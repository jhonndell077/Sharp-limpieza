{
  "rules": {
    ".read": false,
    ".write": false,
    "branchConfig": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isString()"
    },
    "boards": {
      "$branchId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['stateJson']) && newData.child('stateJson').isString()"
      }
    },
    "library": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isString()"
    }
  }
}
